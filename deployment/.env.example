# Safe, non-secret WP49-002 runtime configuration example.
# Copy values through the deployment environment; do not commit real credentials.
# Secret-bearing settings introduced by later work must use an external secret
# provider or runtime injection, never literal values in repository files.

AGRO_ENV=development
AGRO_DEPLOYMENT_MODE=LOCAL_PRIMARY
AGRO_SITE_TIME_ZONE=Etc/UTC
AGRO_LOCAL_WRITE_ENABLED=true
AGRO_CLOUD_WRITE_ENABLED=false
PORT=3000
