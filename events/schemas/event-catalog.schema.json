{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agroplatform.local/schemas/event-catalog.schema.json",
  "title": "AgroPlatform event catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "catalogVersion", "schema_version", "status", "events", "sources"],
  "properties": {
    "$schema": {"type": "string", "pattern": "^\\.\\./schemas/event-catalog\\.schema\\.json$"},
    "catalogVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "pattern": "^BOOTSTRAP$"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "producer", "consumers", "schema"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*)+$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "producer": {"type": "string", "minLength": 1},
          "consumers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "additionalProperties"],
            "properties": {
              "type": {"type": "string", "pattern": "^object$"},
              "additionalProperties": {"type": "boolean"},
              "properties": {"type": "object"},
              "required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "sources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
