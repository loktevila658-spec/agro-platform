{
  "name": "@agroplatform/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contracts:validate": "node scripts/contracts.mjs validate",
    "contracts:generate": "node scripts/contracts.mjs generate",
    "contracts:check": "node scripts/contracts.mjs check",
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./dist/index.js"
  }
}
