{
  "name": "@agroplatform/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --dir ../../apps exec tsc -p ../packages/config/tsconfig.json",
    "typecheck": "pnpm --dir ../../apps exec tsc -p ../packages/config/tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
